From 66095d3f05989a9199b613e157ba882d62024a0a Mon Sep 17 00:00:00 2001
From: Spenser Truex <truex@equwal.com>
Date: Sun, 11 Oct 2026 12:18:26 +0000
Subject: [PATCH] vi: add text objects that follow vim: aw iw aW iW, quotes and
 brackets for c, d and y

---
 src/cmd/ksh93/tests/pty.sh | 66 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/src/cmd/ksh93/tests/pty.sh b/src/cmd/ksh93/tests/pty.sh
index 6cbffc6..ee84251 100755
--- a/src/cmd/ksh93/tests/pty.sh
+++ b/src/cmd/ksh93/tests/pty.sh
@@ -1505,5 +1505,71 @@ w echo bar　uux\Ebiq
 u ^bar　quux\r\n$
 !
 
+((SHOPT_VSH)) && VISUAL=vi tst $LINENO << "!"
+L vi mode text objects
+
+d 15
+p :test-1:
+w echo foo bar baz\E0fbciwqux
+u ^foo qux baz\r\n$
+p :test-2:
+w echo foo bar baz\E0fbdaw
+u ^foo baz\r\n$
+p :test-3:
+w echo foo bar\Edaw
+u ^foo\r\n$
+p :test-4:
+w echo a foo-bar b\E0ffciWx
+u ^a x b\r\n$
+p :test-5:
+w echo a b c d\E0fbdaw.
+u ^a d\r\n$
+p :test-6:
+w echo a b c d\E0fb2daw
+u ^a d\r\n$
+p :test-7:
+w echo a b c d\E0fbd2aw
+u ^a d\r\n$
+p :test-8:
+w echo foo bar\E0ffyiw$p
+u ^foo barfoo\r\n$
+p :test-9:
+w echo foo bar\E0ffdawu
+u ^foo bar\r\n$
+p :test-10:
+w echo "foo bar" baz\E0ci"qux
+u ^qux baz\r\n$
+p :test-11:
+w echo x""y\E0f"ci"z
+u ^xzy\r\n$
+p :test-12:
+w print -r -- '<a<b>c>'\E0fbdi<
+u ^<a<>c>\r\n$
+p :test-13:
+w print -r -- '(a(b)c)'\E0fbd2ib
+u ^\(\)\r\n$
+p :test-14:
+w print -r -- 'x[a]y'\E0fada]
+u ^xy\r\n$
+p :test-15:
+w echo foo\Edi(
+u ^foo\r\n$
+p :test-16:
+w print -r -- 'a "b" c "d" e'\E0fcdi"
+u ^a "b""d" e\r\n$
+p :test-17:
+w print -r -- 'x (a b) y'\E0di(
+u ^x \(\) y\r\n$
+p :test-18:
+w print -r -- '(a ")" b)'\E0fadi(
+u ^\(\)\r\n$
+p :test-19:
+w echo foo\E3daw
+u ^foo\r\n$
+p :test-20:
+w echo foo bar\E0fbciwx\E$p
+u ^foo xbar\r\n$
+!
+
 # ======
 exit $((Errors<125?Errors:125))
-- 
2.55.0

